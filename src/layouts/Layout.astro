---
/**
 * Page shell: document head, SEO tags, global styles, skip link, and the
 * scroll fade-in script.
 */
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Page title. Defaults to the site-wide title. */
  title?: string;
  /** Meta description. Defaults to the site-wide description. */
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } = Astro.props;

// `BASE_URL` is "/" on Vercel (it would include a folder for subpath hosting).
const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

// Canonical URL for this page. `site` and `base` are set in astro.config.mjs.
const canonical = new URL(
  base.endsWith('/') ? base : `${base}/`,
  Astro.site ?? 'https://example.com',
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap-index.xml')} />

    <!-- Inline SVG favicon (no extra request). -->
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

    <!-- Browser UI color, matching the light and dark backgrounds in global.css. -->
    <meta name="theme-color" content="#fcfcfe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d12" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <!-- TODO: Optional — add an og:image (1200×630) and the matching
         <meta property="og:image" ... /> tag once you have a screenshot. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.seo.locale} />

    <!--
      Add the reveal class before paint so sections start hidden only when the
      observer below will actually run. Without JavaScript, content stays visible.
    -->
    <script is:inline>
      // Mark that JavaScript is available (used by the mobile nav styles).
      document.documentElement.classList.add('js');

      if (
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{site.a11y.skipToContent}</a>
    <slot />

    <script is:inline>
      (() => {
        if (!document.documentElement.classList.contains('js-reveal')) return;

        const items = document.querySelectorAll('.reveal');
        if (items.length === 0) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0, rootMargin: '0px 0px -10% 0px' },
        );

        for (const item of items) observer.observe(item);
      })();
    </script>
  </body>
</html>
