---
import { site } from '../data/site';
import WindowFrame from './WindowFrame.astro';
import mainWindow from '../screenshots/main-window.png';

const { hero } = site;
---

<section id="top" class="hero reveal" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">{hero.headline}</h1>
      <p class="hero__lede">{hero.subheadline}</p>

      <div class="hero__actions">
        <a class="btn btn--outline-accent btn--lg" href={hero.primaryCta.href} download>
          <svg class="btn__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {hero.primaryCta.label}
        </a>

        <a
          class="btn btn--secondary btn--lg"
          href={hero.macCta.href}
          target="_blank"
          rel="noreferrer"
        >
          <svg class="btn__icon" viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516.024.034 1.52.087 2.475-1.258.955-1.345.762-2.391.728-2.43Zm3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422.212-2.189 1.675-2.789 1.698-2.854.023-.065-.597-.79-1.254-1.157a3.692 3.692 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56.244.729.625 1.924 1.273 2.796.576.984 1.34 1.667 1.659 1.899.319.232 1.219.386 1.843.067.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758.347-.79.505-1.217.473-1.282Z"
            ></path>
          </svg>
          {hero.macCta.label}
        </a>
      </div>

      <p class="hero__note">{hero.note}</p>
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <WindowFrame
          title={hero.screenshot.windowTitle}
          alt={hero.screenshot.alt}
          placeholderLabel={hero.screenshot.placeholderLabel}
          src={mainWindow}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(3rem, 7vw, 5.25rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Accent glow, fading out from the top of the hero. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      60% 65% at 50% 0%,
      var(--accent-glow),
      transparent 72%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    align-items: center;
    gap: clamp(2.75rem, 6vw, 4.5rem);
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__title {
    max-width: 470px;
    font-size: clamp(2.6rem, 5.7vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__lede {
    max-width: 470px;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .hero__visual {
    position: relative;
    min-width: 0;
    width: 100%;
    max-width: 558px;
    margin-inline: auto;
  }

  .hero__frame {
    position: relative;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 4vw, 3.75rem);
    }

    .hero__visual {
      max-width: none;
    }
  }
</style>
