---
import { site } from '../data/site';
import WindowFrame from './WindowFrame.astro';
import mainWindow from '../screenshots/main-window.png';

const { hero } = site;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">{hero.headline}</h1>
      <p class="hero__lede">{hero.subheadline}</p>

      <div class="hero__actions">
        <a class="btn btn--outline-accent btn--lg" href={hero.primaryCta.href}>
          <svg class="btn__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3v12m0 0 4.5-4.5M12 15 7.5 10.5M4 20h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {hero.primaryCta.label}
        </a>

        <a class="btn btn--secondary btn--lg" href={hero.secondaryCta.href}>
          <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.1c-3.2.7-3.88-1.36-3.88-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.35.77 1.05.77 2.12v3.15c0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
            ></path>
          </svg>
          {hero.secondaryCta.label}
        </a>
      </div>

      <p class="hero__note">{hero.note}</p>
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <WindowFrame
          title={hero.screenshot.windowTitle}
          alt={hero.screenshot.alt}
          placeholderLabel={hero.screenshot.placeholderLabel}
          src={mainWindow}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(3rem, 7vw, 5.25rem) clamp(4rem, 9vw, 7.5rem);
  }

  /* Accent glow, fading out from the top of the hero. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      60% 65% at 50% 0%,
      var(--accent-glow),
      transparent 72%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    align-items: center;
    gap: clamp(2.75rem, 6vw, 4.5rem);
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__title {
    max-width: 470px;
    font-size: clamp(2.6rem, 5.7vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__lede {
    max-width: 470px;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .hero__visual {
    position: relative;
    min-width: 0;
    width: 100%;
    max-width: 558px;
    margin-inline: auto;
  }

  .hero__frame {
    position: relative;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
      gap: clamp(2.5rem, 4vw, 3.75rem);
    }

    .hero__visual {
      max-width: none;
    }
  }
</style>
