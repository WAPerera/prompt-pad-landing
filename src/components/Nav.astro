---
import { site } from '../data/site';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';

const { nav } = site;
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={nav.home.href}>
      <Image
        class="brand__mark"
        src={icon}
        alt=""
        width={72}
        height={72}
        loading="eager"
      />
      <span class="brand__text">{nav.home.label}</span>
    </a>

    <div class="header__actions">
      <nav aria-label={nav.ariaLabel}>
        <ul class="nav-list" role="list">
          {
            nav.links.map((link) => (
              <li>
                <a class="nav-link" href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="btn btn--primary nav-cta" href={nav.cta.href} download>{nav.cta.label}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--border);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .brand__mark {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 9px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .brand__text {
    font-size: 1.02rem;
    white-space: nowrap;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    flex-shrink: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 9px;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link:hover {
    background: var(--bg-tinted);
    color: var(--text);
  }

  .nav-cta {
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  @media (max-width: 420px) {
    .header__inner {
      gap: 0.5rem;
    }

    .header__actions {
      gap: 0.25rem;
    }

    .nav-link {
      padding: 0.4rem 0.45rem;
      font-size: 0.88rem;
    }

    .nav-cta {
      padding: 0.55rem 0.8rem;
      font-size: 0.82rem;
    }

    /* Keep the mark and the actions; the wordmark would force wrapping. */
    .brand__text {
      display: none;
    }
  }


</style>
