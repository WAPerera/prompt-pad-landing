---
import { site } from '../data/site';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';

const { footer, nav } = site;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__row">
      <a class="footer__brand" href={nav.home.href}>
        <Image
          class="footer__mark"
          src={icon}
          alt=""
          width={56}
          height={56}
          loading="lazy"
        />
        <span class="footer__name">{nav.home.label}</span>
      </a>

      <nav class="footer__nav" aria-label={footer.ariaLabel}>
        <ul class="footer__links" role="list">
          {
            footer.links.map((link) => (
              <li>
                <a href={link.href} rel="noreferrer">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="footer__legal">{footer.copyright}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3rem 2rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer__row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .footer__mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 8px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .footer__name {
    font-size: 0.98rem;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    list-style: none;
  }

  .footer__links a {
    color: var(--text-muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .footer__legal {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 720px) {
    .footer__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }
</style>
