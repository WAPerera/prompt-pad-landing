---
/**
 * Problem / solution story shown directly above the interactive prototype.
 */
import { site } from '../data/site';

const { story } = site;
---

<section class="story section reveal" aria-labelledby="story-title">
  <div class="container story__inner">
    <h2 id="story-title" class="story__title">{story.title}</h2>

    <div class="story__body">
      {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .story__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .story__title {
    max-width: 24ch;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .story__body {
    max-width: 58ch;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
  }

  .story__body p + p {
    margin-top: 1rem;
  }

  @media (min-width: 900px) {
    .story__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: clamp(2rem, 5vw, 4rem);
    }

    .story__title {
      max-width: 18ch;
    }
  }
</style>
