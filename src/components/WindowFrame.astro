---
/**
 * A mock desktop app window. When a real screenshot exists, import it and
 * pass it as `src`; otherwise a styled placeholder is shown.
 *
 * Usage with an image (later):
 *
 *   import mainWindow from '../screenshots/main-window.png';
 *   <WindowFrame title="..." alt="..." src={mainWindow} />
 *
 * TODO: For an optimized screenshot, place the file in `src/` (for example
 * `src/screenshots/main-window.png`), import it in Hero.astro, and pass it
 * here as `src`. Files in `public/` are served as-is and cannot be processed
 * by <Image />.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Text in the mock title bar. */
  title: string;
  /** Accessible description of the screenshot / placeholder. */
  alt: string;
  /** Label shown inside the placeholder until a screenshot is provided. */
  placeholderLabel: string;
  /** Real screenshot. Omit to show the placeholder. */
  src?: ImageMetadata;
  /** Set to "lazy" for images far below the fold. */
  loading?: 'eager' | 'lazy';
}

const { title, alt, placeholderLabel, src, loading = 'lazy' } = Astro.props;
---

<div class="window">
  <div class="titlebar" aria-hidden="true">
    <span class="titlebar__brand">
      <span class="titlebar__mark"></span>
      <span class="titlebar__title">{title}</span>
    </span>
    <span class="titlebar__controls">
      <span class="titlebar__control">
        <svg viewBox="0 0 10 10" fill="none">
          <path d="M2 8h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="titlebar__control">
        <svg viewBox="0 0 10 10" fill="none">
          <rect x="2.5" y="2.5" width="5" height="5" rx="0.5" stroke="currentColor" stroke-width="1.2"></rect>
        </svg>
      </span>
      <span class="titlebar__control">
        <svg viewBox="0 0 10 10" fill="none">
          <path d="m2.5 2.5 5 5m0-5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
        </svg>
      </span>
    </span>
  </div>

  <!-- REPLACE: screenshot of main window -->
  {
    src ? (
      <div class="screen screen--image">
        <Image
          src={src}
          alt={alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 620px, 92vw"
          loading={loading}
        />
      </div>
    ) : (
      <div class="screen">
        <div class="placeholder" role="img" aria-label={alt}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect
              x="3"
              y="4"
              width="18"
              height="16"
              rx="2.5"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <circle cx="8.5" cy="9" r="1.4" fill="currentColor" />
            <path
              d="m5 17 4.2-4.2a1.4 1.4 0 0 1 2 0L17 17"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="placeholder__label">{placeholderLabel}</span>
        </div>
      </div>
    )
  }
</div>

<style>
  .window {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
  }

  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 42px;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .titlebar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .titlebar__mark {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border-radius: 4px;
    background: var(--accent);
    opacity: 0.9;
  }

  .titlebar__title {
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .titlebar__controls {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-shrink: 0;
  }

  .titlebar__control {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 5px;
    color: var(--text-muted);
    opacity: 0.75;
  }

  .titlebar__control svg {
    width: 10px;
    height: 10px;
  }

  .screen {
    display: grid;
    place-items: center;
    padding: clamp(1rem, 3vw, 2rem);
    aspect-ratio: 16 / 10;
    background: linear-gradient(
      155deg,
      var(--bg-inset),
      var(--bg-tinted) 55%,
      var(--bg-inset)
    );
  }

  .screen--image {
    display: block;
    padding: 0;
    aspect-ratio: auto;
  }

  .screen--image :global(img) {
    width: 100%;
    height: auto;
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 1rem;
    border: 1.5px dashed var(--border-strong);
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg-elevated) 55%, transparent);
    color: var(--text-muted);
    text-align: center;
  }

  .placeholder svg {
    width: 30px;
    height: 30px;
    color: var(--accent);
    opacity: 0.85;
  }

  .placeholder__label {
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>
